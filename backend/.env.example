APP_HOST=127.0.0.1
APP_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/landex
DATABASE_MAX_CONNECTIONS=10
RUST_LOG=landex_api=debug,actix_web=info

# Google Identity Services web OAuth client ID. Leave empty until configured.
GOOGLE_CLIENT_ID=

# Reserved for Sign in with Apple. The backend does not consume these yet.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Reserved for email verification/password reset. Not consumed yet.
APP_PUBLIC_URL=http://localhost:5173
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=LandEX

# Required only when running the RentCast ingestion job.
RENTCAST_API_KEY=
RENTCAST_CITY=
RENTCAST_STATE=
RENTCAST_ZIP_CODE=
RENTCAST_MAX_PAGES=1

# Optional RayProp ingestion job.
RAYPROP_API_KEY=
RAYPROP_CITY=Lagos
RAYPROP_MAX_PAGES=1

# Optional GeoNames ingestion job.
GEONAMES_USERNAME=
GEONAMES_QUERY=Lagos
GEONAMES_COUNTRY_CODE=NG
GEONAMES_MAX_ROWS=100
GEONAMES_MAX_PAGES=1

# Optional currency refresh job.
FX_BASE_CURRENCY=USD
FX_QUOTE_CURRENCIES=NGN,GBP,EUR,AED,CAD,AUD

# Optional one-property Overpass enrichment job. Explicit approval is required
# before making an external Overpass request during assisted development.
OVERPASS_PROPERTY_ID=
OVERPASS_RADIUS_METERS=3000
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Historical market-data integrations (reserved; ingestion jobs not implemented yet).
# BIS and Eurostat are public/keyless. Keep their official endpoints unchanged.
BIS_API_BASE_URL=https://stats.bis.org/api/v2
EUROSTAT_API_BASE_URL=https://ec.europa.eu/eurostat/api/dissemination

# England and Wales transaction history. Price Paid Data is keyless bulk open data.
# This should point to a chosen official monthly/yearly CSV when the importer is run.
HMLR_PRICE_PAID_DATA_URL=
HMLR_MONTHLY_UPDATE_URL=https://price-paid-data.publicdata.landregistry.gov.uk/pp-monthly-update-new-version.csv
# The importer downloads once to this ignored local cache, resumes interrupted
# transfers, then retries database work from disk without spending more network.
HMLR_CACHE_PATH=.data/hmlr/price-paid-complete.csv
HMLR_DATASET_KEY=complete-history
HMLR_BATCH_SIZE=2000

# Official monthly UK House Price Index history. Keyless; cached once locally.
UK_HPI_CSV_URL=https://publicdata.landregistry.gov.uk/market-trend-data/house-price-index-data/UK-HPI-full-file-2026-06.csv
UK_HPI_CACHE_PATH=.data/hmlr/uk-hpi-full.csv

# US aggregate market-history downloads. These are research CSVs, not listing APIs.
# Paste the official dataset CSV URLs selected for each importer.
ZILLOW_ZHVI_CSV_URL=
ZILLOW_ZORI_CSV_URL=
ZILLOW_INVENTORY_CSV_URL=

# Free account keys for US macroeconomic and housing-context ingestion.
FRED_API_KEY=
US_CENSUS_API_KEY=

# Environmental enrichment. The prototype endpoint is keyless and non-commercial.
# A commercial deployment must use the customer endpoint and a paid API key.
OPEN_METEO_API_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com/v1
OPEN_METEO_API_KEY=
