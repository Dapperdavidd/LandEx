APP_HOST=127.0.0.1
APP_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/landex
DATABASE_MAX_CONNECTIONS=10
RUST_LOG=landex_api=debug,actix_web=info

# Google Identity Services web OAuth client ID. Leave empty until configured.
GOOGLE_CLIENT_ID=

# Reserved for Sign in with Apple. The backend does not consume these yet.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Reserved for email verification/password reset. Not consumed yet.
APP_PUBLIC_URL=http://localhost:5173
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=LandEX

# Required only when running the RentCast ingestion job.
RENTCAST_API_KEY=
RENTCAST_CITY=
RENTCAST_STATE=
RENTCAST_ZIP_CODE=
RENTCAST_MAX_PAGES=1

# Optional RayProp ingestion job.
RAYPROP_API_KEY=
RAYPROP_CITY=Lagos
RAYPROP_MAX_PAGES=1

# Optional GeoNames ingestion job.
GEONAMES_USERNAME=
GEONAMES_QUERY=Lagos
GEONAMES_COUNTRY_CODE=NG
GEONAMES_MAX_ROWS=100
GEONAMES_MAX_PAGES=1

# Optional currency refresh job.
FX_BASE_CURRENCY=USD
FX_QUOTE_CURRENCIES=NGN,GBP,EUR,AED,CAD,AUD

# Optional one-property Overpass enrichment job. Explicit approval is required
# before making an external Overpass request during assisted development.
OVERPASS_PROPERTY_ID=
OVERPASS_RADIUS_METERS=3000
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
